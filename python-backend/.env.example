# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 排除，不会进仓库）
#
# 必填：OpenAI 或兼容中转站的 API Key
OPENAI_API_KEY=

# 可选：自定义 OpenAI 兼容端点。不填则使用官方 https://api.openai.com/v1
# 若使用第三方中转站，填到 /v1 为止，例如 https://example.com/v1
# OPENAI_BASE_URL=

# 可选：responses | chat_completions
# 中转站只支持 /v1/chat/completions 时，改成 chat_completions
# OPENAI_API_MODE=responses

# 可选：模型名，默认 gpt-4o-mini
# AGENT_MODEL=gpt-4o-mini

# 可选：行情数据源
#   auto  优先真实行情（腾讯 + 东方财富），异常自动回退模拟数据（默认）
#   live  只用真实行情，失败直接报错，便于排查接口
#   mock  只用本地模拟数据，完全离线
STOCK_DATA_SOURCE=auto
